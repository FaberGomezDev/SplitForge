<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- Permite compilar los proyectos WPF desde Linux (CI y desarrollo); solo se ejecutan en Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>0.7.0</Version>
    <Product>SplitForge</Product>
    <Company>SplitForge</Company>
    <Copyright>SplitForge</Copyright>
    <NeutralLanguage>es</NeutralLanguage>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
