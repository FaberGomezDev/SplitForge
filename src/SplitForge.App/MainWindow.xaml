<Window x:Class="SplitForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="1220" Height="840" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True">
  <Grid>
    <Grid.Resources>
      <!-- Solo para el árbol lógico de la ventana: no cruza las plantillas de los controles. -->
      <Style TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Navegación principal: JUGAR · MANDOS · AVANZADO -->
    <TabControl Style="{StaticResource NavTabs}" Tag="{Binding VersionLine}">

      <!-- ═══ JUGAR ═══ -->
      <TabItem Header="JUGAR" Tag="&#xE768;" Style="{StaticResource NavItem}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="34,28,34,26">

            <!-- Biblioteca: se elige el juego; la lista crece con cada adaptador nuevo. -->
            <TextBlock Style="{StaticResource SectionLabel}" Text="BIBLIOTECA" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
              <ListBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" AutomationProperties.Name="Biblioteca"
                       Background="Transparent" BorderThickness="0" Padding="0"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.Template>
                  <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter />
                  </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <Border x:Name="Tile" Width="260" Height="78" CornerRadius="12" Background="{StaticResource Card}"
                                  BorderBrush="{StaticResource Line}" BorderThickness="1.5" Margin="0,0,12,0">
                            <ContentPresenter />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="Tile" Property="Background" Value="{StaticResource CardHi}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="Tile" Property="Background" Value="{StaticResource CardHi}" />
                              <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Border Width="52" CornerRadius="10,0,0,10" Margin="1">
                        <Border.Background>
                          <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                        </Border.Background>
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,12,0">
                        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Display}" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Tagline}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Grid Width="200" Height="78">
                <Rectangle RadiusX="12" RadiusY="12" Stroke="{StaticResource Line}" StrokeThickness="1.5" StrokeDashArray="4 3" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                  <TextBlock Text="Más juegos" Foreground="{StaticResource Muted}" FontFamily="{StaticResource Display}" FontSize="15" HorizontalAlignment="Center" />
                  <TextBlock Text="próximamente" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center" />
                </StackPanel>
              </Grid>
            </StackPanel>

            <!-- Portada del juego y botón de jugar -->
            <Grid Height="280" Margin="0,0,0,24">
              <Border CornerRadius="16">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#3A2112" Offset="0" />
                    <GradientStop Color="#141821" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <Border CornerRadius="16">
                <Border.Background>
                  <ImageBrush ImageSource="{Binding GameHero}" Stretch="UniformToFill" AlignmentY="Top" />
                </Border.Background>
              </Border>
              <Border CornerRadius="16">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#F20B0D12" Offset="0" />
                    <GradientStop Color="#B80B0D12" Offset="0.42" />
                    <GradientStop Color="#000B0D12" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <StackPanel Margin="34,0,0,30" VerticalAlignment="Bottom" HorizontalAlignment="Left" MaxWidth="540">
                <TextBlock Text="{Binding GameBanner}" FontFamily="{StaticResource Display}" FontSize="12"
                           FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,0,0,10" />
                <Image Source="{Binding GameLogo}" Height="84" HorizontalAlignment="Left" Stretch="Uniform" Margin="0,0,0,12">
                  <Image.Style>
                    <Style TargetType="Image">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding GameLogo}" Value="{x:Null}">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Image.Style>
                </Image>
                <TextBlock Text="{Binding GameTitle}" FontFamily="{StaticResource Display}" FontSize="46" FontWeight="Bold" Margin="0,0,0,8">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding GameLogo}" Value="{x:Null}">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding PlayHeadline}" Foreground="#D5DCE8" FontSize="14" Margin="0,0,0,18" />
                <StackPanel Orientation="Horizontal">
                  <Button Style="{StaticResource PlayButton}" Command="{Binding PlayCommand}" AutomationProperties.Name="Jugar"
                          ToolTip="{Binding PlayToolTip}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE768;" FontFamily="{StaticResource Icons}" FontSize="15" VerticalAlignment="Center" Margin="0,1,11,0" />
                      <TextBlock Text="JUGAR" />
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource GhostButton}" Content="Cerrar juegos" Command="{Binding CloseGamesCommand}" Padding="18,13"
                          ToolTip="Cierre normal, como cerrar la ventana de cada juego. Nunca a la fuerza." />
                </StackPanel>
              </StackPanel>
            </Grid>

            <!-- Jugadores y preparación -->
            <Grid Margin="0,0,0,24">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="2*" />
              </Grid.ColumnDefinitions>

              <StackPanel>
                <TextBlock Style="{StaticResource SectionLabel}" Text="JUGADORES" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                      <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource P1}">
                          <TextBlock Text="J1" FontFamily="{StaticResource Display}" FontWeight="Bold" FontSize="14" Foreground="White"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBox Text="{Binding Persona1, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="12,0,0,0"
                                 Visibility="{Binding EmulatedIdentity, Converter={StaticResource Visible}}"
                                 ToolTip="Nombre con el que este jugador aparece en la partida." />
                        <TextBlock Text="Con su cuenta de Steam" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Visibility="{Binding AccountIdentity, Converter={StaticResource Visible}}" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Mando" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ComboBox ItemsSource="{Binding XInputSlots}" SelectedItem="{Binding SlotPlayer1}" Width="64" MinWidth="64" />
                        <Button Content="Detectar" Command="{Binding DetectSlotCommand}" CommandParameter="1" Margin="8,0,0,0"
                                ToolTip="Pulsa después un botón en el mando de este jugador." />
                      </StackPanel>
                      <TextBlock Text="{Binding Player1Pad}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                    <StackPanel>
                      <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource P2}">
                          <TextBlock Text="J2" FontFamily="{StaticResource Display}" FontWeight="Bold" FontSize="14" Foreground="White"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBox Text="{Binding Persona2, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="12,0,0,0"
                                 Visibility="{Binding EmulatedIdentity, Converter={StaticResource Visible}}"
                                 ToolTip="Nombre con el que este jugador aparece en la partida." />
                        <TextBlock Text="Con la cuenta de su copia" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Visibility="{Binding AccountIdentity, Converter={StaticResource Visible}}" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Mando" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ComboBox ItemsSource="{Binding XInputSlots}" SelectedItem="{Binding SlotPlayer2}" Width="64" MinWidth="64" />
                        <Button Content="Detectar" Command="{Binding DetectSlotCommand}" CommandParameter="2" Margin="8,0,0,0"
                                ToolTip="Pulsa después un botón en el mando de este jugador." />
                      </StackPanel>
                      <TextBlock Text="{Binding Player2Pad}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0" />
                    </StackPanel>
                  </Border>
                </Grid>
              </StackPanel>

              <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource SectionLabel}" Text="PREPARACIÓN" />
                <Border Style="{StaticResource CardBorder}">
                  <StackPanel>
                    <ItemsControl ItemsSource="{Binding PlaySteps}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="26" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{Binding Color}" Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1">
                              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                              <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Preparar ahora" Style="{StaticResource PrimaryButton}" Command="{Binding PrepareCommand}"
                            Visibility="{Binding PlayCanPrepare, Converter={StaticResource Visible}}" HorizontalAlignment="Left" Margin="0,4,0,0"
                            ToolTip="Instala en el juego lo que falte. Cada paso pide confirmación y se puede deshacer en AVANZADO." />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>

            <!-- Opciones -->
            <TextBlock Style="{StaticResource SectionLabel}" Text="OPCIONES" />
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,24">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="24" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Pantalla" FontWeight="SemiBold" Margin="0,0,0,10" />
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton Content="Arriba / abajo" IsChecked="{Binding OrientationStacked}" GroupName="orientation" />
                    <RadioButton Content="Lado a lado" IsChecked="{Binding OrientationSideBySide}" GroupName="orientation" />
                  </StackPanel>
                  <CheckBox Content="Tapar la barra de tareas" IsChecked="{Binding CoverTaskbar}" Margin="0,0,0,9"
                            ToolTip="La pantalla dividida usa el monitor completo. Al terminar, todo vuelve a su sitio." />
                  <CheckBox Content="Fondo negro detrás de los juegos" IsChecked="{Binding BlackBackdrop}"
                            ToolTip="Tapa el escritorio en la unión entre ventanas. No consume recursos y desaparece al terminar." />
                </StackPanel>
                <StackPanel Grid.Column="2" Visibility="{Binding AccountIdentity, Converter={StaticResource Visible}}">
                  <TextBlock Text="Copias del juego" FontWeight="SemiBold" Margin="0,0,0,10" />
                  <TextBlock Text="{Binding NoMansSkyCopiesText}" Margin="0,0,0,6" />
                  <TextBlock Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                             Text="Cada jugador entra con su propia copia y su cuenta. La de J1 es la de Steam; la de J2 se detecta si es de GOG o la indicas tú." />
                  <StackPanel Orientation="Horizontal">
                    <Button Content="Elegir copia de J2…" Command="{Binding PickNoMansSkyCopyCommand}"
                            ToolTip="Elige el NMS.exe (carpeta Binaries) de la copia del jugador 2." />
                    <Button Content="Quitar filtro de mandos" Command="{Binding RemoveNoMansSkyFilterCommand}" Margin="8,0,0,0"
                            Visibility="{Binding NoMansSkyFilterInstalled, Converter={StaticResource Visible}}"
                            ToolTip="Retira de la carpeta del juego el archivo que instaló SplitForge. Con el juego cerrado." />
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Visibility="{Binding EmulatedIdentity, Converter={StaticResource Visible}}">
                  <TextBlock Text="Partida" FontWeight="SemiBold" Margin="0,0,0,10" />
                  <CheckBox Content="J2 con sus propios guardados" IsChecked="{Binding SteamEmuIsolateSaves}" Margin="0,0,0,9"
                            ToolTip="J2 usa su propia carpeta de datos: no ve ni puede pisar las partidas de J1." />
                  <CheckBox Content="El otro jugador entra solo" IsChecked="{Binding SteamEmuAutoJoin}" Margin="0,0,0,9"
                            ToolTip="Cuando un jugador abre una partida, el otro entra en ella sin tocar nada (vale para J1 y para J2). Si estaba en otra partida, la guarda y sale." />
                  <CheckBox Content="J1 carga su última partida" IsChecked="{Binding SteamEmuQuickContinue}"
                            ToolTip="J1 no pasa por el menú del juego: abre directamente su última partida." />
                </StackPanel>
              </Grid>
            </Border>

            <!-- Cómo se juega -->
            <TextBlock Style="{StaticResource SectionLabel}" Text="CÓMO SE JUEGA" />
            <Border Style="{StaticResource CardBorder}">
              <StackPanel>
                <TextBlock Margin="0,0,0,6" TextWrapping="Wrap"><Run Text="1  " Foreground="{StaticResource Accent}" FontWeight="Bold" /><Run Text="{Binding HowTo1, Mode=OneWay}" /></TextBlock>
                <TextBlock Margin="0,0,0,6" TextWrapping="Wrap"><Run Text="2  " Foreground="{StaticResource Accent}" FontWeight="Bold" /><Run Text="{Binding HowTo2, Mode=OneWay}" /></TextBlock>
                <TextBlock Margin="0,0,0,10" TextWrapping="Wrap"><Run Text="3  " Foreground="{StaticResource Accent}" FontWeight="Bold" /><Run Text="{Binding HowTo3, Mode=OneWay}" /></TextBlock>
                <TextBlock Foreground="{StaticResource Muted}" FontSize="12">
                  <Run Text="Solo mandos (bloquea teclado y ratón): " /><Run Text="{Binding InputLockHotkey, Mode=OneWay}" FontWeight="SemiBold" />
                  <Run Text="  ·  Ratón dentro de una ventana: " /><Run Text="{Binding MouseLockHotkey, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ═══ MANDOS ═══ -->
      <TabItem Header="MANDOS" Tag="&#xE7FC;" Style="{StaticResource NavItem}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="34,28,34,26">
            <TextBlock Style="{StaticResource Heading}" Text="Mandos conectados" />
            <TextBlock Style="{StaticResource Hint}" Text="Mueve un stick o pulsa un botón para ver la respuesta en vivo. Funciona aunque el juego tenga el foco." />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
              <Button Content="Identificar (luz y vibración)" Style="{StaticResource PrimaryButton}" Command="{Binding IdentifyCommand}" />
              <TextBlock Text="Lector" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="10,0,8,0" />
              <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" Width="130" Margin="0,0,8,0" />
              <Button Content="Aplicar" Command="{Binding ApplyModeCommand}" />
            </StackPanel>
            <Border Style="{StaticResource PanelBorder}" Padding="6">
              <ListView ItemsSource="{Binding Pads}" SelectedItem="{Binding SelectedPad}" MinHeight="120" MaxHeight="230" Background="Transparent">
                <ListView.View>
                  <GridView>
                    <GridViewColumn Header="Mando" Width="215" DisplayMemberBinding="{Binding Label}" />
                    <GridViewColumn Header="Tipo" Width="110" DisplayMemberBinding="{Binding Type}" />
                    <GridViewColumn Header="Carga" Width="130" DisplayMemberBinding="{Binding Battery}" />
                    <GridViewColumn Header="Lectura" Width="85" DisplayMemberBinding="{Binding Path}" />
                    <GridViewColumn Header="Estado en vivo" Width="355" DisplayMemberBinding="{Binding Live}" />
                  </GridView>
                </ListView.View>
              </ListView>
            </Border>
            <Border Style="{StaticResource PanelBorder}">
              <TextBlock Style="{StaticResource Mono}" Text="{Binding SelectedPad.Raw, FallbackValue='Selecciona un mando para ver su lectura.'}" />
            </Border>

            <TextBlock Style="{StaticResource Heading}" Text="Perfil del mando seleccionado" FontSize="16" Margin="0,14,0,4" />
            <TextBlock Style="{StaticResource Hint}" Text="Solo para el laboratorio de SplitForge. Pulsa Aprender y después el botón del mando. Los mandos del mismo modelo comparten perfil." />
            <WrapPanel>
              <StackPanel Margin="0,0,18,8">
                <TextBlock Text="Eje X" Foreground="{StaticResource Muted}" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding AxisChoices}" SelectedItem="{Binding MapAxisX}" Width="70" />
              </StackPanel>
              <StackPanel Margin="0,0,24,8">
                <TextBlock Text="Eje Y" Foreground="{StaticResource Muted}" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding AxisChoices}" SelectedItem="{Binding MapAxisY}" Width="70" />
              </StackPanel>
              <StackPanel Margin="0,0,18,8">
                <TextBlock Text="Disparo (Cruz / R2)" Foreground="{StaticResource Muted}" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal">
                  <ComboBox ItemsSource="{Binding ButtonChoices}" SelectedItem="{Binding MapFire}" Width="70" Margin="0,0,6,0" />
                  <Button Content="Aprender" Command="{Binding LearnCommand}" CommandParameter="fire" />
                </StackPanel>
              </StackPanel>
              <StackPanel Margin="0,0,18,8">
                <TextBlock Text="Impulso (Círculo)" Foreground="{StaticResource Muted}" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal">
                  <ComboBox ItemsSource="{Binding ButtonChoices}" SelectedItem="{Binding MapDash}" Width="70" Margin="0,0,6,0" />
                  <Button Content="Aprender" Command="{Binding LearnCommand}" CommandParameter="dash" />
                </StackPanel>
              </StackPanel>
              <StackPanel Margin="0,0,18,8">
                <TextBlock Text="Escudo (Cuadrado)" Foreground="{StaticResource Muted}" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal">
                  <ComboBox ItemsSource="{Binding ButtonChoices}" SelectedItem="{Binding MapShield}" Width="70" Margin="0,0,6,0" />
                  <Button Content="Aprender" Command="{Binding LearnCommand}" CommandParameter="shield" />
                </StackPanel>
              </StackPanel>
            </WrapPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,8">
              <CheckBox Content="Invertir X" IsChecked="{Binding InvertX}" />
              <CheckBox Content="Invertir Y" IsChecked="{Binding InvertY}" />
              <Button Content="Guardar perfil" Command="{Binding SaveMappingCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding CaptureStatus}" Foreground="{StaticResource Accent}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ═══ AVANZADO: todo lo técnico, fuera del camino ═══ -->
      <TabItem Header="AVANZADO" Tag="&#xE713;" Style="{StaticResource NavItem}">
        <Grid Margin="34,22,34,20">
          <TabControl>

            <TabItem Header="PANTALLA">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <TextBlock Style="{StaticResource Heading}" Text="Distribución de las ventanas" />
                  <WrapPanel Margin="0,0,0,10">
                    <TextBlock Text="Separación" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding Gutters}" SelectedItem="{Binding Gutter}" Width="70" Margin="0,0,18,0" />
                    <CheckBox Content="Sin bordes" IsChecked="{Binding Borderless}" />
                    <CheckBox Content="Mantener proporción" IsChecked="{Binding FitKeepAspect}"
                              ToolTip="Centra el juego con su proporción, sin deformarlo. Deja franjas si la región no coincide." />
                    <ComboBox ItemsSource="{Binding AspectChoices}" SelectedItem="{Binding SelectedAspect}" DisplayMemberPath="Label"
                              IsEnabled="{Binding FitKeepAspect}" Width="80" />
                  </WrapPanel>
                  <TextBlock Text="{Binding PaneHint}" Style="{StaticResource Hint}" />
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <Button Content="Reaplicar distribución" Command="{Binding RelayoutCommand}" />
                    <Button Content="Restaurar / detener sesión" Command="{Binding StopCommand}" />
                  </StackPanel>

                  <TextBlock Style="{StaticResource Heading}" Text="Ratón y teclado" FontSize="16" />
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="{Binding MouseLockButtonText}" Command="{Binding ToggleMouseLockCommand}" ToolTip="{Binding MouseLockStatus}" />
                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="2,0,18,0">
                      <Run Text="Atajo: " /><Run Text="{Binding MouseLockHotkey, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                    <Button Content="{Binding InputLockButtonText}" Command="{Binding ToggleInputLockCommand}"
                            ToolTip="El teclado y el ratón dejan de llegar a los juegos y al escritorio; solo funcionan los mandos. Se suelta con el mismo atajo." />
                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="2,0,0,0">
                      <Run Text="Atajo: " /><Run Text="{Binding InputLockHotkey, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                  </StackPanel>

                  <TextBlock Style="{StaticResource Heading}" Text="Foco simulado" FontSize="16" Margin="0,14,0,6" />
                  <CheckBox Content="Simular foco en cada ventana" IsChecked="{Binding FakeFocusEnabled}" Margin="0,0,0,6" />
                  <TextBlock Style="{StaticResource Hint}" Text="SplitForge envía a cada ventana los mensajes de activación de Windows para que la que no tiene el foco siga atendiendo a su mando. No modifica el juego." Margin="0,0,0,2" />
                  <TextBlock Text="{Binding FakeFocusStatus}" Foreground="{StaticResource Muted}" />
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="7 DAYS TO DIE">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <TextBlock Style="{StaticResource Heading}" Text="Emulador de Steam" />
                  <TextBlock Style="{StaticResource Hint}" Text="Sustituye steam_api64.dll del juego por una versión con identidad local, para que dos ventanas entren como jugadores distintos. La DLL original queda respaldada. Requiere el juego sin EAC; restaura antes de verificar archivos en Steam." />
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="Instalar / actualizar" Style="{StaticResource PrimaryButton}" Command="{Binding InstallSteamEmuCommand}" />
                    <Button Content="Restaurar DLL original" Command="{Binding RestoreSteamEmuCommand}" />
                    <Button Content="Seleccionar DLL…" Command="{Binding PickSteamEmuDllCommand}" />
                  </StackPanel>
                  <TextBlock Text="{Binding SteamEmuStatus}" Foreground="{StaticResource Muted}" Margin="0,0,0,10" />
                  <WrapPanel Margin="0,0,0,6">
                    <TextBlock Text="AppID" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,8,0" />
                    <TextBox Text="{Binding SteamEmuAppId, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="0,0,18,0" />
                    <TextBlock Text="SteamID de J1" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,8,0" />
                    <TextBox Text="{Binding SteamId1, UpdateSourceTrigger=PropertyChanged}" Width="160" Margin="0,0,18,0" />
                    <TextBlock Text="SteamID de J2" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,8,0" />
                    <TextBox Text="{Binding SteamId2, UpdateSourceTrigger=PropertyChanged}" Width="160" />
                  </WrapPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,6,0,18">
                    <Button Content="Lanzar solo J1" Command="{Binding LaunchSteamEmu1Command}" />
                    <Button Content="Lanzar solo J2" Command="{Binding LaunchSteamEmu2Command}" />
                  </StackPanel>

                  <TextBlock Style="{StaticResource Heading}" Text="Filtro de mandos" FontSize="16" />
                  <TextBlock Style="{StaticResource Hint}" Text="Hace que cada ventana vea solo su mando. Se instala en la carpeta del juego sin sobrescribir nada suyo y se puede quitar en cualquier momento." />
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="Instalar filtro" Command="{Binding InstallFilterCommand}" />
                    <Button Content="Asignar mandos a los clientes" Command="{Binding AssignFilterCommand}" />
                    <Button Content="Quitar filtro" Command="{Binding RemoveFilterCommand}" />
                  </StackPanel>
                  <TextBlock Text="{Binding XInputSlotsStatus}" Foreground="{StaticResource Muted}" Margin="0,0,0,4" />
                  <TextBlock Text="{Binding FilterStatus}" Foreground="{StaticResource Muted}" Margin="0,0,0,18" />

                  <TextBlock Style="{StaticResource Heading}" Text="Diagnóstico" FontSize="16" />
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="Comprobar" Command="{Binding CheckSevenCommand}" />
                    <Button Content="Guardar diagnóstico" Command="{Binding ExportSevenCommand}" />
                  </StackPanel>
                  <TextBlock Text="{Binding SevenState}" Foreground="{StaticResource Muted}" Margin="0,0,0,6" />
                  <ItemsControl ItemsSource="{Binding SevenChecks}" Margin="0,0,0,18">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,3">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Icon}" Foreground="{Binding Color}" FontWeight="Bold" FontSize="15" />
                          <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,10,0" />
                          <TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <TextBlock Style="{StaticResource Heading}" Text="Servidor dedicado oficial (opcional)" FontSize="16" />
                  <TextBlock Style="{StaticResource Hint}" Text="Alternativa a que un jugador aloje la partida: servidor local con guardados propios en la carpeta de SplitForge. Requiere instalar «7 Days to Die Dedicated Server» desde Steam." />
                  <WrapPanel Margin="0,0,0,8">
                    <TextBlock Text="Puerto" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,6,0" />
                    <TextBox Text="{Binding ServerPort, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,14,0" />
                    <TextBlock Text="Jugadores" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding PlayerCounts}" SelectedItem="{Binding ServerMaxPlayers}" Width="64" MinWidth="64" Margin="0,0,14,0" />
                    <TextBlock Text="Contraseña" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,6,0" />
                    <TextBox Text="{Binding ServerPassword, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,14,0" />
                    <CheckBox Content="Servidor con EAC" IsChecked="{Binding ServerEac}" />
                  </WrapPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="Iniciar servidor" Command="{Binding StartServerCommand}" />
                    <Button Content="Detener servidor" Command="{Binding StopServerCommand}" />
                    <Button Content="Steam de J2 (Sandboxie-Plus)" Command="{Binding OpenSecondSteamCommand}" />
                    <Button Content="Dividir pantalla con los clientes" Command="{Binding TileSevenCommand}" />
                    <Button Content="Intercambiar J1 / J2" Command="{Binding SwapSevenCommand}" />
                  </StackPanel>
                  <TextBlock Text="{Binding ServerStatus}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding JoinInstructions}" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
                  <Border Style="{StaticResource PanelBorder}" MaxHeight="150">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                      <TextBlock Style="{StaticResource Mono}" FontSize="11" Text="{Binding ServerLog}" />
                    </ScrollViewer>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="LABORATORIO">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <TextBlock Style="{StaticResource Heading}" Text="Mundo de prueba: 2 perspectivas, 1 misma partida" />
                  <TextBlock Style="{StaticResource Hint}" Text="Un mundo simulado propio de SplitForge en dos ventanas. Sirve para probar mandos y pantalla dividida sin abrir ningún juego. Stick: mover · Cruz/R2: disparo · Círculo: impulso · Cuadrado: escudo." />
                  <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition />
                      <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Mando del jugador 1" Margin="0,4,12,4" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Pads}" DisplayMemberPath="Label" SelectedItem="{Binding LabPlayer1}" Margin="0,4" />
                    <TextBlock Grid.Row="1" Text="Mando del jugador 2" Margin="0,4,12,4" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Pads}" DisplayMemberPath="Label" SelectedItem="{Binding LabPlayer2}" Margin="0,4" />
                  </Grid>
                  <StackPanel Orientation="Horizontal">
                    <Button Content="INICIAR MUNDO COMPARTIDO" Style="{StaticResource PrimaryButton}" Command="{Binding StartLabCommand}" />
                    <Button Content="Reasignar mandos en vivo" Command="{Binding ReassignLabCommand}" />
                  </StackPanel>
                  <TextBlock Text="Señal que llega a la simulación" Foreground="{StaticResource Muted}" FontWeight="SemiBold" Margin="0,16,0,4" />
                  <Border Style="{StaticResource PanelBorder}">
                    <TextBlock Style="{StaticResource Mono}" FontSize="14" Text="{Binding LabStatus}" />
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="VENTANAS">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource Heading}" Text="Dividir ventanas que ya estén abiertas" />
                  <TextBlock Style="{StaticResource Hint}" Text="Selecciona de 2 a 4 ventanas con Ctrl + clic, en el orden J1, J2, J3, J4. Solo se cambia su tamaño y posición; sus procesos nunca se cierran." />
                  <Button Content="Actualizar lista" Command="{Binding RefreshWindowsCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" />
                </StackPanel>
                <ListBox x:Name="WindowsList" Grid.Row="1" ItemsSource="{Binding VisibleWindows}" DisplayMemberPath="Label" SelectionMode="Extended" />
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                  <Button Content="DIVIDIR SELECCIONADAS" Style="{StaticResource PrimaryButton}"
                          Command="{Binding AttachWindowsCommand}" CommandParameter="{Binding SelectedItems, ElementName=WindowsList}" />
                  <TextBlock Text="Mejor con los juegos en modo ventana." Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                </StackPanel>
              </Grid>
            </TabItem>

            <TabItem Header="STEAM">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource Heading}" Text="Biblioteca de Steam" />
                  <TextBlock Style="{StaticResource Hint}" Text="Solo inspecciona tus juegos: detectar uno no significa que sea compatible." />
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Escanear Steam" Command="{Binding ScanSteamCommand}" />
                    <Button Content="Guardar reporte sin datos personales" Command="{Binding ExportSteamCommand}" />
                    <Button Content="Abrir carpeta del juego" Command="{Binding OpenGameFolderCommand}" />
                    <Button Content="Abrir en Steam (1 instancia)" Command="{Binding LaunchSteamCommand}" />
                  </StackPanel>
                  <TextBlock Text="{Binding SteamSummary}" Foreground="{StaticResource Muted}" Margin="0,0,0,6" />
                </StackPanel>
                <ListView Grid.Row="1" ItemsSource="{Binding SteamGames}" SelectedItem="{Binding SelectedSteamGame}">
                  <ListView.View>
                    <GridView>
                      <GridViewColumn Header="AppID" Width="90" DisplayMemberBinding="{Binding AppId}" />
                      <GridViewColumn Header="Juego" Width="340" DisplayMemberBinding="{Binding Name}" />
                      <GridViewColumn Header="Estado de investigación" Width="340" DisplayMemberBinding="{Binding Phase}" />
                    </GridView>
                  </ListView.View>
                </ListView>
                <Border Grid.Row="2" Style="{StaticResource PanelBorder}" MaxHeight="130">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock Style="{StaticResource Mono}" Text="{Binding SteamDetail}" />
                  </ScrollViewer>
                </Border>
                <TextBlock Grid.Row="3" Style="{StaticResource Heading}" Text="Clientes abiertos de un mismo juego" FontSize="16" Margin="0,8,0,6" />
                <StackPanel Grid.Row="4">
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <ComboBox ItemsSource="{Binding SteamGames}" DisplayMemberPath="Label" SelectedItem="{Binding WindowsGame}" Width="320" Margin="0,0,8,0" />
                    <Button Content="Analizar ventanas" Command="{Binding AnalyzeGameWindowsCommand}" />
                    <Button Content="Dividir clientes" Command="{Binding TileGameWindowsCommand}" />
                  </StackPanel>
                  <Border Style="{StaticResource PanelBorder}" MaxHeight="110">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                      <TextBlock Style="{StaticResource Mono}" Text="{Binding GameWindowsReport}" />
                    </ScrollViewer>
                  </Border>
                </StackPanel>
              </Grid>
            </TabItem>

            <TabItem Header="REGISTRO">
              <Border Style="{StaticResource PanelBorder}" Margin="0">
                <ListBox x:Name="LogList" ItemsSource="{Binding LogLines}" FontFamily="Consolas" FontSize="11" Foreground="#C9D3E2" Background="Transparent" />
              </Border>
            </TabItem>
          </TabControl>
        </Grid>
      </TabItem>
    </TabControl>

    <!-- Barra de estado -->
    <Border Grid.Row="1" Background="{StaticResource Rail}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,9">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="{Binding InputLockButtonText}" Command="{Binding ToggleInputLockCommand}" Padding="12,6"
                  ToolTip="El teclado y el ratón dejan de llegar a los juegos y al escritorio; solo funcionan los mandos. Se suelta con el mismo atajo." />
          <Button Content="Detener sesión" Command="{Binding StopCommand}" Padding="12,6" Margin="0"
                  ToolTip="Deshace la pantalla dividida y devuelve las ventanas a su sitio. No cierra los juegos." />
        </StackPanel>
        <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0" />
        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        <TextBlock Text="{Binding InputSummary}" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="18,0,12,0"
                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
