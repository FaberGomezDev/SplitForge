<Window x:Class="SplitForge.App.LockNotice"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SplitForge · aviso de bloqueo"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" Focusable="False" IsHitTestVisible="False"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual" Left="0" Top="0"
        AutomationProperties.Name="Aviso de bloqueo de entrada">
  <!-- Aviso superpuesto del bloqueo «solo mandos»: cartel grande al cambiar y, mientras dura, una insignia. -->
  <Border x:Name="Box" CornerRadius="14" BorderThickness="2" BorderBrush="{StaticResource Accent}" Background="#F00B0D12"
          Padding="28,18" SnapsToDevicePixels="True">
    <StackPanel Orientation="Horizontal">
      <TextBlock x:Name="Glyph" FontFamily="{StaticResource Icons}" FontSize="40" Text="&#xE72E;"
                 Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,18,0" />
      <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="Headline" FontFamily="{StaticResource Display}" FontSize="30" FontWeight="Bold"
                   Foreground="{StaticResource Text}" />
        <TextBlock x:Name="Detail" FontSize="16" Foreground="#D0F2F5FA" Margin="0,4,0,0" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
